# Copy to .env and change what differs on your machine. Every line is optional:
# the values below are the defaults.

# --- MariaDB (docker-compose.yml starts one on port 3309)
DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=rabbithole
DB_PASSWORD=rabbithole
DB_NAME=rabbithole

# --- Embedding model: turns a question into a vector. Must be bge-m3, the model the article
# vectors of dataset S were made with. Without it, questions are matched by keywords.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3

# --- The model that writes answers: any OpenAI-compatible chat endpoint.
# Default: Ollama on this machine, and the first Gemma model it has (ollama pull gemma4).
# A hosted model, for example one served with vLLM on a Verda GPU instance:
#   LLM_BASE_URL=http://<host>:8000/v1
#   LLM_API_KEY=<key, if the endpoint wants one>
#   LLM_MODEL=<the model name the endpoint lists>
#LLM_BASE_URL=http://localhost:11434/v1
#LLM_API_KEY=
#LLM_MODEL=

# --- How many candidates one vector index search looks at (mhnsw_ef_search)
EF_SEARCH=80

# --- The web page
PORT=8000

# --- No database at hand? SNAPSHOT=1 replays the answers recorded in rabbithole/snapshot/
# (python pipeline/snapshot.py makes them). On Vercel this is on by itself when DB_HOST is not set.
#SNAPSHOT=1
